DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=menu.local,192.0.2.10
MENU_BIND_ADDRESS=192.0.2.10
MENU_PORT=18766
MENU_DATA_DIR=/var/lib/menu-familiar/data

MENU_IMAGE=menu-familiar:verified-REPLACE_WITH_COMMIT

# For Tailscale Serve, add the tailnet hostname to DJANGO_ALLOWED_HOSTS too.
# Set the proxy IP to the gateway of the menu-familiar Compose bridge.
DJANGO_TAILSCALE_HOST=
DJANGO_TAILSCALE_PROXY_IP=
